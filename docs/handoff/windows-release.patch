diff --git a/.github/workflows/windows-install-smoke.yml b/.github/workflows/windows-install-smoke.yml
new file mode 100644
index 0000000..d87839f
--- /dev/null
+++ b/.github/workflows/windows-install-smoke.yml
@@ -0,0 +1,53 @@
+name: Windows install smoke
+
+# Not part of the default CI matrix. Runs when a release is published, and
+# when a pull request touches the installer, the npm wrapper, or OS-specific
+# path code. Other pull requests do not start this job.
+
+on:
+  release:
+    types: [published]
+  pull_request:
+    paths:
+      - packages/cli/bin/**
+      - packages/cli/package.json
+      - scripts/install.sh
+      - scripts/install.ps1
+      - scripts/setup.mjs
+      - scripts/setup.sh
+      - scripts/setup.ps1
+      - scripts/fast-check.mjs
+      - scripts/fast-check.sh
+      - scripts/fast-check.ps1
+      - packages/core/src/phantom-process.ts
+      - packages/cli/src/lib/fleet-gc.ts
+      - .github/workflows/release.yml
+      - .github/workflows/windows-install-smoke.yml
+
+permissions:
+  contents: read
+
+jobs:
+  windows-install:
+    name: Windows npm wrapper smoke
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
+        with:
+          node-version: "20"
+
+      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
+        with:
+          bun-version: "1.4.4"
+
+      - name: Install and build the JavaScript CLI
+        run: |
+          bun install --frozen-lockfile
+          bun run --cwd packages/cli build
+
+      - name: Run the npm wrapper
+        run: |
+          node packages/cli/bin/stack.mjs --version
+          node packages/cli/bin/stack.mjs providers --json
