{
  "name": "ashlr-stack-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Ashlr Stack — the control plane for your entire dev stack. Provisions, wires, and operates every service in your project with one command.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:crypto": "node --test scripts/check-crypto.node-tests.mjs && node scripts/check-crypto.mjs",
    "check:links": "node --test scripts/check-readme-links.node-tests.mjs && node scripts/check-readme-links.mjs",
    "fresh:sync": "node scripts/freshness/sync.mjs",
    "fresh:check": "node scripts/freshness/check.mjs",
    "fresh:test": "node --test scripts/freshness/freshness.node-tests.mjs",
    "build": "bun run --filter '*' build",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write .",
    "setup-hooks": "git config core.hooksPath .githooks && echo 'pre-commit hook wired via .githooks'"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
