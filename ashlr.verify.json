{
  "schemaVersion": 1,
  "mode": "replace-detected",
  "commands": [
    {
      "id": "typecheck",
      "kind": "typecheck",
      "cmd": ["bun", "run", "typecheck"],
      "cwd": ".",
      "timeoutMs": 180000,
      "required": true,
      "profiles": ["quick", "merge"]
    },
    {
      "id": "test",
      "kind": "test",
      "cmd": ["bun", "test"],
      "cwd": ".",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge"]
    },
    {
      "id": "build",
      "kind": "build",
      "cmd": ["bun", "run", "build"],
      "cwd": ".",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge"]
    },
    {
      "id": "cli-help-smoke",
      "kind": "test",
      "cmd": ["bun", "run", "packages/cli/src/index.ts", "--help"],
      "cwd": ".",
      "timeoutMs": 60000,
      "required": true,
      "profiles": ["merge"]
    },
    {
      "id": "cli-providers-smoke",
      "kind": "test",
      "cmd": ["bun", "run", "packages/cli/src/index.ts", "providers"],
      "cwd": ".",
      "timeoutMs": 60000,
      "required": true,
      "profiles": ["merge"]
    },
    {
      "id": "cli-recommend-smoke",
      "kind": "test",
      "cmd": ["bun", "run", "packages/cli/src/index.ts", "recommend", "B2B SaaS with auth and payments", "--json"],
      "cwd": ".",
      "timeoutMs": 60000,
      "required": true,
      "profiles": ["merge"]
    }
  ]
}
