---
import { getIconPath } from "~/lib/icons";
import { PROVIDERS } from "~/lib/providers";
import { TEMPLATES_REF } from "~/lib/templates-ref";
import TemplateExplorer, { type Template } from "./TemplateExplorer";

interface TemplateEntry {
  id: string;
  title: string;
  blurb: string;
  /** Display names from providers.ts (for icon resolution). */
  stack: string[];
  /** Ref names from providers-ref.ts (for recipe generation). */
  refNames: string[];
  accent?: string;
}

// A homepage selection of the shipped templates. Each `refNames` list matches
// the `[services.*]` providers in `templates/<id>/stack.toml`; the full set
// (TEMPLATES_REF) is listed on /docs/templates/.
const TEMPLATES: TemplateEntry[] = [
  {
    id: "nextjs-supabase-posthog",
    title: "Next.js + Supabase + PostHog",
    blurb: "Supabase (Postgres and auth) and PostHog slots for a Next.js app.",
    stack: ["Supabase", "PostHog"],
    refNames: ["supabase", "posthog"],
    accent: "3ECF8E",
  },
  {
    id: "nextjs-neon-vercel-sentry",
    title: "Next.js + Neon + Vercel + Sentry",
    blurb: "Serverless Postgres on Neon, deploys on Vercel, error tracking with Sentry.",
    stack: ["Neon", "Vercel", "Sentry"],
    refNames: ["neon", "vercel", "sentry"],
    accent: "8B5CF6",
  },
  {
    id: "claude-agent-openai-anthropic",
    title: "Claude agent — OpenAI · Anthropic · xAI · DeepSeek · GitHub",
    blurb: "Model API slots for four providers, plus GitHub with its MCP entry.",
    stack: ["OpenAI", "Anthropic", "xAI", "DeepSeek", "GitHub"],
    refNames: ["openai", "anthropic", "xai", "deepseek", "github"],
    accent: "D97757",
  },
  {
    id: "supabase-posthog-sentry-resend",
    title: "SaaS starter — Supabase · PostHog · Sentry · Resend · Stripe",
    blurb: "Auth, analytics, errors, transactional email and payments, declared from day one.",
    stack: ["Supabase", "PostHog", "Sentry", "Resend", "Stripe"],
    refNames: ["supabase", "posthog", "sentry", "resend", "stripe"],
    accent: "F54E00",
  },
  {
    id: "cloudflare-turso-clerk",
    title: "Cloudflare + Turso + Clerk + Sentry",
    blurb: "Edge deploys on Cloudflare, libSQL via Turso, users via Clerk, errors via Sentry.",
    stack: ["Cloudflare", "Turso", "Clerk", "Sentry"],
    refNames: ["cloudflare", "turso", "clerk", "sentry"],
    accent: "F38020",
  },
];

const providerMap = new Map(PROVIDERS.map((p) => [p.name, p]));

const templates: Template[] = TEMPLATES.map((t) => ({
  id: t.id,
  title: t.title,
  blurb: t.blurb,
  refNames: t.refNames,
  accent: t.accent,
  iconPaths: t.stack.map((name) => {
    const p = providerMap.get(name);
    return p ? getIconPath(p.slug) : null;
  }),
  iconNames: t.stack,
  iconColors: t.stack.map((name) => providerMap.get(name)?.color ?? "6b8097"),
}));
---

<section id="templates" class="relative mx-auto max-w-[1240px] px-6 sm:px-10 pt-16 sm:pt-20 pb-24 sm:pb-28">
  <div class="section-rule mb-10">
    <span>§ 06 · Starter stacks · {String(TEMPLATES_REF.length).padStart(2, "0")}</span>
  </div>

  <header class="max-w-[760px] mb-12" data-reveal>
    <h2 class="display text-[color:var(--color-ink-50)]" style="font-size: clamp(32px, 4.4vw, 56px);">
      Opinionated starters, <span class="display-accent">ready to explore.</span>
    </h2>
    <p class="mt-5 text-[15px] leading-[1.6] text-[color:var(--color-ink-300)] max-w-[620px]">
      Explore an illustrative starter recipe, supported <code class="mono text-[color:var(--color-ink-100)]">stack add</code> commands,
      optional empty-key <code class="mono text-[color:var(--color-ink-100)]">.env.example</code> entries,
      and MCP possibilities. Actual files and provider results depend on successful setup.
    </p>
  </header>

  <div data-reveal>
    <TemplateExplorer templates={templates} client:visible />
  </div>

  <div class="mt-8 break-words text-sm text-[color:var(--color-ink-400)]">
    <span class="inline-block w-1 h-1 mr-3 align-middle rounded-full bg-[color:var(--color-ink-500)]"></span>
    Showing {TEMPLATES.length} of {TEMPLATES_REF.length} shipped templates. The experimental
    <code class="mono text-[color:var(--color-ink-200)]">litellm-gateway</code> and
    <code class="mono text-[color:var(--color-ink-200)]">temporal-worker-phantom</code> starters, and the
    services every template declares, are on the <a href="/docs/templates/" class="underline hover:text-[color:var(--color-ink-100)]">templates page</a>.
    <code class="mono text-[color:var(--color-ink-200)]">stack templates list --json</code> prints the same list.
  </div>

  <div class="mt-4 break-words text-sm text-[color:var(--color-ink-400)]">
    <span class="inline-block w-1 h-1 mr-3 align-middle rounded-full bg-[color:var(--color-ink-500)]"></span>
    Don't see your stack? In an interactive terminal, <code class="mono text-[color:var(--color-ink-200)]">stack init</code> offers blank or a starter template. Choosing a template attempts setup for its listed services by default; use <code class="mono text-[color:var(--color-ink-200)]">--noProvision</code> with a template to write config only.
  </div>
</section>
