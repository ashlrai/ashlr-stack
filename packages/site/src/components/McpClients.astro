---
import McpClientsGrid from "./McpClientsGrid";
import { PUBLISHED_VERSION, SOURCE_VERSION } from "~/lib/site-facts.generated";
---

<section
  id="mcp-clients"
  class="relative mx-auto max-w-[1240px] px-6 sm:px-10 pt-14 sm:pt-16 pb-6"
>
  <div class="section-rule mb-10">
    <span>§ 08 · Agent surface</span>
  </div>

  <header class="max-w-[760px] mb-10" data-reveal>
    <h2 class="display text-[color:var(--color-ink-50)]" style="font-size: clamp(30px, 4.2vw, 50px);">
      Connect an MCP-capable agent, <span class="display-accent">with explicit setup.</span>
    </h2>
    <p class="mt-5 text-[15px] leading-[1.6] text-[color:var(--color-ink-300)] max-w-[620px]">
      The <code class="mono text-[color:var(--color-blade-400)]">ashlr-stack-mcp</code>
      stdio server also needs the Stack CLI and the runtime required by your installed versions.
      Public {PUBLISHED_VERSION} packages require Bun 1.2+; reviewed source {SOURCE_VERSION} is not a publication claim.
      Click a client for a canonical server-entry example, then adapt it to that client's
      configuration format and launch it in your project directory.
    </p>
  </header>

  <div data-reveal>
    <McpClientsGrid client:visible />
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-[color:var(--color-ink-500)]" data-reveal>
    <span class="small-caps">Protocol:</span>
    <span class="mono text-[color:var(--color-ink-300)]">Model Context Protocol</span>
    <span class="text-[color:var(--color-ink-600)]">·</span>
    <a href="https://modelcontextprotocol.io" class="hover:text-[color:var(--color-ink-200)] underline decoration-[color:var(--color-ink-600)] underline-offset-2" target="_blank" rel="noopener">
      modelcontextprotocol.io
    </a>
    <span class="text-[color:var(--color-ink-600)]">·</span>
    <span>Source: 19 tools · up to 3 raw-file resources · stdio</span>
  </div>
</section>
