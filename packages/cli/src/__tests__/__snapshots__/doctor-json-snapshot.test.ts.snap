// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`doctor CLI output snapshots --json without a project 1`] = `
{
  "checks": [
    {
      "id": "stack-doctor",
      "status": "fail",
      "summary": "No .stack.toml at <project>/.stack.toml. Run \`stack init\` first.",
    },
  ],
  "error": "No .stack.toml at <project>/.stack.toml. Run \`stack init\` first.",
  "kind": "ashlr.doctor",
  "native_status": "error",
  "schema_version": 1,
  "status": "fail",
  "tool": "ashlr-stack",
}
`;

exports[`doctor CLI output snapshots --json without Phantom 1`] = `
